## 6.3 Model 6: Elastic Net Regression

Elastic Net combines L1 (Lasso) and L2 (Ridge) regularization. It can perform feature selection (like Lasso) while handling correlated predictors (like Ridge).

### 6.3.1 Model Training with Hyperparameter Tuning

```{r enet-model}
# Define tuning grid for alpha and lambda
# alpha = 0: Ridge, alpha = 1: Lasso, 0 < alpha < 1: Elastic Net
enet_grid <- expand.grid(
  alpha = seq(0.1, 0.9, by = 0.1),  # Mix of L1 and L2
  lambda = 10^seq(-4, 1, length = 30)
)

# Train Elastic Net model using scaled data
enet_model <- train(
  ph ~ .,
  data = train_scaled,
  method = "glmnet",
  trControl = ctrl_5fold,
  tuneGrid = enet_grid,
  na.action = na.omit
)

# Model summary
print(enet_model)

# Best parameters
cat("\nBest alpha:", enet_model$bestTune$alpha)
cat("\nBest lambda:", enet_model$bestTune$lambda)
```

### 6.3.2 Hyperparameter Tuning Visualization

```{r enet-tuning}
# Plot tuning results
plot(enet_model, main = "Elastic Net: Alpha and Lambda Tuning (5-Fold CV)")

# Heatmap of RMSE across alpha and lambda
enet_results_heatmap <- enet_model$results %>%
  mutate(log_lambda = log10(lambda))

ggplot(enet_results_heatmap, aes(x = log_lambda, y = factor(alpha), fill = RMSE)) +
  geom_tile() +
  scale_fill_viridis_c(option = "plasma") +
  labs(title = "Elastic Net: RMSE Heatmap",
       x = "log10(Lambda)", y = "Alpha (L1 Ratio)",
       fill = "RMSE") +
  theme_minimal()
```

### 6.3.3 Coefficient Analysis

```{r enet-coefficients}
# Extract coefficients at optimal parameters
enet_coef <- coef(enet_model$finalModel, s = enet_model$bestTune$lambda)
enet_coef_df <- data.frame(
  Variable = rownames(enet_coef),
  Coefficient = as.numeric(enet_coef)
) %>%
  filter(Variable != "(Intercept)") %>%
  arrange(desc(abs(Coefficient)))

# Count non-zero coefficients (feature selection)
n_nonzero <- sum(enet_coef_df$Coefficient != 0)
cat("\nNumber of non-zero coefficients:", n_nonzero, "out of", nrow(enet_coef_df))

# Top 15 coefficients by magnitude
print("\nTop 15 Elastic Net Coefficients (by absolute value):")
print(head(enet_coef_df, 15))

# Coefficient plot
ggplot(head(enet_coef_df, 15), 
       aes(x = reorder(Variable, abs(Coefficient)), y = Coefficient)) +
  geom_bar(stat = "identity", fill = "purple", alpha = 0.7) +
  coord_flip() +
  labs(title = "Elastic Net: Top 15 Coefficients",
       subtitle = paste("Alpha =", enet_model$bestTune$alpha, 
                       "| Non-zero features:", n_nonzero),
       x = "Variable", y = "Coefficient") +
  theme_minimal()
```

### 6.3.4 Feature Selection Analysis

```{r enet-feature-selection}
# Variables with zero coefficients (excluded by elastic net)
zero_coef_vars <- enet_coef_df %>%
  filter(Coefficient == 0) %>%
  pull(Variable)

if(length(zero_coef_vars) > 0) {
  cat("\nVariables excluded by Elastic Net (coefficient = 0):\n")
  print(zero_coef_vars)
} else {
  cat("\nNo variables were excluded by Elastic Net.\n")
}

# Variables retained
retained_vars <- enet_coef_df %>%
  filter(Coefficient != 0) %>%
  arrange(desc(abs(Coefficient)))

cat("\nVariables retained (non-zero coefficients):", nrow(retained_vars))
```

### 6.3.5 Coefficient Path

```{r enet-path}
# Coefficient path plot at optimal alpha
plot(enet_model$finalModel, xvar = "lambda", label = TRUE)
title(paste("Elastic Net: Coefficient Path (alpha =", 
            enet_model$bestTune$alpha, ")"))
```

### 6.3.6 Cross-Validation Performance

```{r enet-cv-performance}
# Cross-validation results for best parameters
enet_cv_results <- enet_model$results %>%
  filter(alpha == enet_model$bestTune$alpha,
         lambda == enet_model$bestTune$lambda)

print("Elastic Net Cross-Validation Results (5-fold):")
print(enet_cv_results)

cat("\nElastic Net Cross-Validation RMSE:", round(enet_cv_results$RMSE, 4))
cat("\nElastic Net Cross-Validation R-squared:", round(enet_cv_results$Rsquared, 4))
cat("\nElastic Net Cross-Validation MAE:", round(enet_cv_results$MAE, 4))
```

