## 2.1 Load Training and Test Set

```{r load-data}
# Read data
train_raw <- read.csv("StudentData.csv")
eval_raw  <- read.csv("StudentEvaluation.csv")

# Clean column names
train_data <- train_raw %>% clean_names()
test_data  <- eval_raw %>% clean_names()

# Quick structure check
glimpse(train_data)
glimpse(test_data)
```

## 2.2 Data Preprocessing

```{r preprocessing}
# Check for missing values in training data
missing_summary <- train_data %>%
  summarise(across(everything(), ~sum(is.na(.)))) %>%
  pivot_longer(everything(), names_to = "variable", values_to = "missing_count") %>%
  filter(missing_count > 0) %>%
  arrange(desc(missing_count))

print("Variables with missing values:")
print(missing_summary)

# Impute missing values with median for numeric columns
train_clean <- train_data %>%
  mutate(across(where(is.numeric), ~ifelse(is.na(.), median(., na.rm = TRUE), .)))

test_clean <- test_data %>%
  mutate(across(where(is.numeric), ~ifelse(is.na(.), median(., na.rm = TRUE), .)))

# Remove any rows where pH is still missing (target variable)
train_clean <- train_clean %>% filter(!is.na(ph))

# Store predictor names (all columns except pH)
predictor_vars <- setdiff(names(train_clean), "ph")

# For KNN and regularized models, we need to scale features
# Create a preprocessing object
preProc <- preProcess(train_clean[, predictor_vars], 
                      method = c("center", "scale", "medianImpute"))

# Apply preprocessing
train_scaled <- predict(preProc, train_clean)
test_scaled <- predict(preProc, test_clean)
```

