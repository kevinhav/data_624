  test_metrics <- data.frame(
    Model = c("MLR", "Random Forest", "GBM", "KNN", "Ridge", "Elastic Net"),
    Test_RMSE = c(
      rmse(test_actual, test_clean$pred_mlr[valid_idx]),
      rmse(test_actual, test_clean$pred_rf[valid_idx]),
      rmse(test_actual, test_clean$pred_gbm[valid_idx]),
      rmse(test_actual, test_clean$pred_knn[valid_idx]),
      rmse(test_actual, test_clean$pred_ridge[valid_idx]),
      rmse(test_actual, test_clean$pred_enet[valid_idx])
    ),
    Test_MAE = c(
      mae(test_actual, test_clean$pred_mlr[valid_idx]),
      mae(test_actual, test_clean$pred_rf[valid_idx]),
      mae(test_actual, test_clean$pred_gbm[valid_idx]),
      mae(test_actual, test_clean$pred_knn[valid_idx]),
      mae(test_actual, test_clean$pred_ridge[valid_idx]),
      mae(test_actual, test_clean$pred_enet[valid_idx])
    ),
    Test_Rsquared = c(
      cor(test_actual, test_clean$pred_mlr[valid_idx])^2,
