# 7. Model Comparison

## 7.1 Cross-Validation Performance Summary

```{r model-comparison}
# Collect cross-validation results from all 6 models
model_comparison <- data.frame(
  Model = c("Multiple Linear Regression", 
            "Random Forest", 
            "Gradient Boosted Trees",
            "k-Nearest Neighbors",
            "Ridge Regression",
            "Elastic Net"),
  CV_Type = c("10-fold (3x)", "10-fold (3x)", "10-fold (3x)",
              "5-fold", "5-fold", "5-fold"),
  CV_RMSE = c(
    mlr_model$results$RMSE,
    rf_model$results$RMSE[rf_model$results$mtry == rf_model$bestTune$mtry],
    gbm_cv_results$RMSE,
    knn_cv_results$RMSE,
    ridge_cv_results$RMSE,
    enet_cv_results$RMSE
  ),
  CV_Rsquared = c(
    mlr_model$results$Rsquared,
    rf_model$results$Rsquared[rf_model$results$mtry == rf_model$bestTune$mtry],
    gbm_cv_results$Rsquared,
    knn_cv_results$Rsquared,
    ridge_cv_results$Rsquared,
    enet_cv_results$Rsquared
  ),
  CV_MAE = c(
    mlr_model$results$MAE,
    rf_model$results$MAE[rf_model$results$mtry == rf_model$bestTune$mtry],
    gbm_cv_results$MAE,
    knn_cv_results$MAE,
    ridge_cv_results$MAE,
    enet_cv_results$MAE
  )
)

# Sort by RMSE
model_comparison <- model_comparison %>% 
  arrange(CV_RMSE)

print("Model Comparison (Cross-Validation Performance):")
print(model_comparison)

# Visualization
model_comparison %>%
  pivot_longer(c(CV_RMSE, CV_Rsquared, CV_MAE), 
               names_to = "Metric", values_to = "Value") %>%
  ggplot(aes(x = reorder(Model, -Value), y = Value, fill = CV_Type)) +
  geom_bar(stat = "identity") +
  facet_wrap(~Metric, scales = "free_y") +
  labs(title = "Model Comparison - Cross-Validation Metrics",
       x = "Model", y = "Value",
       fill = "CV Type") +
  theme_minimal() +
  theme(axis.text.x = element_text(angle = 45, hjust = 1))
