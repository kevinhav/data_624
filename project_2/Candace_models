## 5.3 Model 3: Gradient Boosted Trees (GBM)

Gradient Boosting Machines build sequential trees where each tree corrects the errors of the previous one.

### 5.3.1 Model Training with Hyperparameter Tuning

```{r gbm-model}
# Define tuning grid
gbm_grid <- expand.grid(
  n.trees = c(100, 200, 500),
  interaction.depth = c(1, 3, 5),
  shrinkage = c(0.01, 0.1),
  n.minobsinnode = c(10)
)

# Train GBM model
gbm_model <- train(
  ph ~ .,
  data = train_clean,
  method = "gbm",
  trControl = ctrl_10fold,
  tuneGrid = gbm_grid,
  verbose = FALSE,
  na.action = na.omit
)

# Model summary
print(gbm_model)

# Best tuning parameters
cat("\nBest Parameters:")
cat("\n  n.trees:", gbm_model$bestTune$n.trees)
cat("\n  interaction.depth:", gbm_model$bestTune$interaction.depth)
cat("\n  shrinkage:", gbm_model$bestTune$shrinkage)
cat("\n  n.minobsinnode:", gbm_model$bestTune$n.minobsinnode)
```

### 5.3.2 Hyperparameter Tuning Visualization

```{r gbm-tuning}
# Plot tuning results
plot(gbm_model, main = "GBM Hyperparameter Tuning")
```

### 5.3.3 Variable Importance

```{r gbm-importance}
# Variable importance
gbm_importance <- varImp(gbm_model, scale = TRUE)
plot(gbm_importance, top = 15, main = "GBM Variable Importance")

# Summary of the final model
gbm_summary <- summary(gbm_model$finalModel, plotit = FALSE)
print("Top 15 Important Variables (Relative Influence):")
print(head(gbm_summary, 15))
```

### 5.3.4 Partial Dependence Plots

```{r gbm-pdp}
# Partial dependence plots for top 4 variables
top_vars <- head(gbm_summary$var, 4)

par(mfrow = c(2, 2))
for(var in top_vars) {
  plot(gbm_model$finalModel, i.var = var, main = paste("PDP:", var))
}
par(mfrow = c(1, 1))
```

### 5.3.5 Cross-Validation Performance

```{r gbm-cv-performance}
# Cross-validation results for best parameters
gbm_cv_results <- gbm_model$results %>%
  filter(n.trees == gbm_model$bestTune$n.trees,
         interaction.depth == gbm_model$bestTune$interaction.depth,
         shrinkage == gbm_model$bestTune$shrinkage)

print("GBM Cross-Validation Results (10-fold, 3 repeats):")
print(gbm_cv_results)

cat("\nGBM Cross-Validation RMSE:", round(gbm_cv_results$RMSE, 4))
cat("\nGBM Cross-Validation R-squared:", round(gbm_cv_results$Rsquared, 4))
```

